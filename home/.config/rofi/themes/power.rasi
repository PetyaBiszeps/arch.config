* {
  font: "Noto Sans 12";

  accent: #2ec5e7;
  danger: #bf616a;
  foreground: #e5e9f0;
  background: #282c34;
  background-alt: #343a45;
}

window {
  width: 605px;
  anchor: center;
  location: center;
  border-radius: 12px;
  background-color: @background;
}

mainbox {
  padding: 20px;
  spacing: 10px;
  children: [inputbar, message, listview];
}

inputbar {
  spacing: 10px;
  children: [textbox-prompt-colon, dummy, prompt];
}

textbox-prompt-colon {
  str: "";
  padding: 10px 14px;
  text-color: @background;
  border-radius: 6px;
  background-color: @danger;
}

prompt {
  padding: 10px;
  text-color: @background;
  border-radius: 6px;
  background-color: @accent;
}

message {
  padding: 10px;
  border-radius: 6px;
  background-color: @background-alt;
}

textbox {
  text-color: @foreground;
  vertical-align: 0.5;
  horizontal-align: 0.5;
}

listview {
  lines: 1;
  columns: 5;
  spacing: 10px;
  scrollbar: false;
  fixed-height: true;
  fixed-columns: true;
}

element {
  padding: 12px 4px;
  text-color: @foreground;
  border-radius: 6px;
  background-color: @background-alt;
}

element-text {
  font: "Noto Sans, Symbols Nerd Font 11";
  text-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
  background-color: transparent;
}

element selected.normal {
  text-color: @background;
  background-color: @accent;
}

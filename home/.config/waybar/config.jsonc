{
  "height": 32,
  "spacing": 3,
  "position": "top",
  "margin-top": 8,
  "margin-left": 450,
  "margin-right": 450,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": ["clock#time", "clock#date"],
  "modules-right": [
    "custom/power"
  ],

  // Misc
  "reload_style_on_change": true,

  // Modules
  "include": [
    "~/.config/waybar/modules/power.jsonc",
    "~/.config/waybar/modules/clock.jsonc",
    "~/.config/waybar/modules/launcher.jsonc",
    "~/.config/waybar/modules/workspaces.jsonc"
  ]
}

{
  "height": 32,
  "spacing": 3,
  "position": "top",
  "exclusive": false,
  "margin-top": 8,
  "margin-left": 450,
  "margin-right": 450,

  "modules-left": [
    "custom/logo",
    "ext/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "wireplumber",
    "custom/lock"
  ],

  // Modules
  "custom/logo": {
    "format": "",
    "tooltip": false
  },

  "ext/workspaces": {
    "format": "{icon}",
    "sort-by-id": true,
    "ignore-hidden": true,
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "✱"
    },
    "on-click": "activate"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": ["", "", ""],
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "custom/lock": {
    "format": "",
    "tooltip": false
  },

  // Misc
  "reload_style_on_change": true
}

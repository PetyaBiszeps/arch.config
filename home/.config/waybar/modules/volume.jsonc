{
  "pulseaudio#output": {
    "cursor": true,
    "format": "<span rise='1500'>{icon}</span> \u200a{volume}%",
    "format-muted": "<span rise='1500'>{icon}</span> \u200a{volume}%",
    "format-icons": {
      "default": "󰋋",
      "default-muted": "󰟎",
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "headset": "󰋎",
      "headset-muted": "󰋐"
    },
    "tooltip-format": "Output Device: {desc}",
    "on-click": "vicinae 'vicinae://launch/@rastsislaux/store.vicinae.pulseaudio/outputDevices'",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  }
}

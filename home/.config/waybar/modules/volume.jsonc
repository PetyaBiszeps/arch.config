{
  "pulseaudio#output": {
    "format": "<span rise='1500'>{icon}</span> \u200a{volume}%",
    "format-muted": "<span rise='1500'>{icon}</span> \u200a{volume}%",
    "format-icons": {
      "default": "󰋋",
      "default-muted": "󰟎",
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "headset": "󰋎",
      "headset-muted": "󰋐"
    },
    "tooltip-format": "Output Device: {desc}"
  }
}

{
  "network": {
    "cursor": true,
    "tooltip": false,
    "interval": 10,

    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤯",
    "format-disabled": "󰤮",

    "format-icons": [
      "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
    ],
    "on-click": "vicinae 'vicinae://launch/@dagimg-dot/store.vicinae.wifi-commander/scan-wifi'",
    "on-click-right": "vicinae 'vicinae://launch/@dagimg-dot/store.vicinae.wifi-commander/manage-saved-networks'"
  }
}

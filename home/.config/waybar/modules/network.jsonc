{
  "network": {
    "interval": 10,
    "cursor": "pointer",

    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤯",
    "format-disabled": "󰤮",

    "format-icons": [
      "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
    ],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "Ethernet: {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Wi-Fi disabled"
  }
}
